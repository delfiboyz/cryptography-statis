{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "ulimit -n 65536 2>/dev/null; exec npm run dev"
      ],
      "port": 3000
    },
    {
      "name": "start",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "3001",
        "--directory",
        "out"
      ],
      "port": 3001
    }
  ]
}
